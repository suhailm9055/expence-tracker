# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the publishable key shown in Project Settings > API. Older Supabase
# projects may instead use NEXT_PUBLIC_SUPABASE_ANON_KEY; the app accepts both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# NEVER put the service_role key in a NEXT_PUBLIC_ variable and never commit it.
# It is only used server-side, e.g. in a protected admin script, never in this app's runtime code.
# SUPABASE_SERVICE_ROLE_KEY=only-if-you-add-a-trusted-server-only-script
